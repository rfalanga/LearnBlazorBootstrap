@page "/"
@using BlazorBootstrap
@using LearnBlazorBootstrap.Models

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<Grid TItem="Person"
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Class="table table-hover table-bordered table-striped"
      PageSize="5"
      Responsive="true"
      Data="@People"
      RowKeySelector="@(person => person.Id)"
      SelectionMode="GridSelectionMode.Multiple">

    <GridColumns>
        <GridColumn TItem="Person" Field="@nameof(Person.Id)" Title="Id" Sortable="true" Filterable="true" />
        <GridColumn TItem="Person" Field="@nameof(Person.FirstName)" Title="First Name" Sortable="true" Filterable="true" />
        <GridColumn TItem="Person" Field="@nameof(Person.LastName)" Title="Last Name" Sortable="true" Filterable="true" />
        <GridColumn TItem="Person" Field="@nameof(Person.Age)" Title="Age" Sortable="true" Filterable="true" />
    </GridColumns>
</Grid>