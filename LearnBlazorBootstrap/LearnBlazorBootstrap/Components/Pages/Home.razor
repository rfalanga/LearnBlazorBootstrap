@page "/"
@using BlazorBootstrap
@using LearnBlazorBootstrap.Models

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<Grid TItem="People"
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Class="table table-hover table-bordered table-striped"
      PageSize="5"
      Responsive="true"
      Data="@People"
      RowKeySelector="@(person => person.Id)"
      SelectionMode="GridSelectionMode.Multiple">

    <GridColumns>
        <GridColumn TItem="People" Field="@nameof(People.Id)" Title="Id" Sortable="true" Filterable="true" />
        <GridColumn TItem="People" Field="@nameof(People.Name)" Title="Name" Sortable="true" Filterable="true" />
        <GridColumn TItem="People" Field="@nameof(People.Age)" Title="Age" Sortable="true" Filterable="true" />
        <GridColumn TItem="People" Field="@nameof(People.Email)" Title="Email" Sortable="true" Filterable="true" />
    </GridColumns>
</Grid>