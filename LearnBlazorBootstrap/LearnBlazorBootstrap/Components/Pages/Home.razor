@page "/"
@using BlazorBootstrap
@using LearnBlazorBootstrap.Models

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<Grid TItem="Person"
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Class="table table-hover table-bordered table-striped"
      PageSize="5"
      Responsive="true"
      Data="@People"
      RowKeySelector="@(person => person.Id)"
      SelectionMode="GridSelectionMode.Multiple">

    <GridColumns>
        <GridColumn TItem="Person" PropertyName="Id" HeaderText="Id" Sortable="true" Filterable="true">
            @context.Id
        </GridColumn>
        <GridColumn TItem="Person" PropertyName="FirstName" HeaderText="First Name" Sortable="true" Filterable="true">
            @context.FirstName
        </GridColumn>
        <GridColumn TItem="Person" PropertyName="LastName" HeaderText="Last Name" Sortable="true" Filterable="true">
            @context.LastName
        </GridColumn>
        <GridColumn TItem="Person" PropertyName="Age" HeaderText="Age" Sortable="true" Filterable="true">
            @context.Age
        </GridColumn>
    </GridColumns>
</Grid>

<h3>After the BlazorBootstrap Grid</h3>
